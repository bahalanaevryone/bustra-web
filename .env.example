VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Map viewport only; this is never a bus location.
VITE_MAP_LAT=13.2233
VITE_MAP_LNG=120.5960
# Community OSM tiles are for light development use. Configure a production provider.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
# Optional OSRM-compatible router. Blank disables routing; road directions are not bus approval.
# For light testing only: https://router.project-osrm.org
VITE_ROUTING_URL=
# GitHub Pages builds set /bustra-web/; leave / for local development.
VITE_BASE_PATH=/
