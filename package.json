{
  "name": "bustra-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native --host 127.0.0.1",
    "build": "tsc -b && vite build --configLoader native",
    "preview": "vite preview --configLoader native --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --config vitest.config.ts --configLoader native",
    "test:db": "node scripts/test-database.mjs",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run test:db && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.0",
    "@tailwindcss/vite": "^4.2.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.13.0",
    "tailwindcss": "^4.2.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@playwright/test": "^1.58.2",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
